# Copy to .env (git-ignored) and fill in what you use:  cp .env.example .env && chmod 600 .env
# `loop` loads .env from the repository root automatically; variables already set in your shell
# take precedence. Configs only ever name these variables; values are never written to run
# records, synced to remote hosts, or passed into task containers.

# --- Runpod: automatic start/stop of pods (`kind: runpod` hosts, `loop pod ...`) --------------
# Account API key (Runpod console -> Settings -> API Keys). Used on this machine only; pods stop
# themselves with their own pod-scoped key, never this one.
RUNPOD_API_KEY=

# --- Model endpoints -----------------------------------------------------------------------
# Key for an OpenAI-compatible endpoint that requires one. Machine profiles refer to it with
# `api_key_env: LLM_API_KEY`; the plain Harbor workflow (evaluation/run.sh) also reads it.
LLM_API_KEY=
# Default endpoint for the plain Harbor workflow (evaluation/run.sh); `loop` takes endpoints from
# machine profiles instead.
LLM_API_BASE=

# --- Hugging Face ----------------------------------------------------------------------------
# Token for gated models (e.g. google/gemma-4-E4B-it) and higher download rate limits on this
# machine. Not forwarded to remote hosts: set it there separately if a pod must download gated
# models.
HF_TOKEN=

# --- Optional ---------------------------------------------------------------------------------
# Alternative env file for `loop` (default: <repo>/.env); only meaningful in your shell.
# LOOP_ENV_FILE=
# Directory `loop preflight` checks for free disk space (default: runs).
# LOOP_RUNS_DIR=
